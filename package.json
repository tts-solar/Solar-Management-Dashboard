{
  "name": "solar-management-dashboard",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "scripts": {
    "dev": "vite --mode demo",
    "dev:offline": "vite --mode offline",
    "build": "tsc --noEmit && npm run build:offline && npm run build:demo && npm run check:privacy",
    "build:demo": "vite build --mode demo",
    "build:offline": "vite build --mode offline",
    "check:privacy": "node tools/privacy-check.mjs",
    "preview": "vite preview",
    "test": "vitest run"
  },
  "dependencies": {
    "@fontsource/montserrat": "^5.3.0",
    "chart.js": "^4.5.1",
    "chartjs-chart-treemap": "^4.2.2"
  },
  "devDependencies": {
    "typescript": "^7.0.2",
    "vite": "^8.3.0",
    "vite-plugin-singlefile": "^2.3.3",
    "vitest": "^5.0.1"
  }
}
